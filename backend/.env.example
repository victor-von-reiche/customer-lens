# Demo mode never calls Gemini, even if a key is present.
APP_MODE=live
GEMINI_API_KEY=
# Existing GOOGLE_API_KEY is also accepted; set only one key variable.
GEMINI_MODEL=gemini-3.5-flash-lite

# Demo mode ignores DATABASE_URL and uses demo.db unless overridden.
# DEMO_DATABASE_URL=sqlite:////absolute/path/to/demo.db
# Live mode uses DATABASE_URL or customer_lens.db.
# DATABASE_URL=sqlite:////absolute/path/to/customer_lens.db

# Optional: protect every ticket endpoint with a bearer token.
ADMIN_API_TOKEN=

# Lexical retrieval needs no downloads; chroma requires requirements-vector.txt.
RAG_BACKEND=lexical

# Optional USD rates for the selected model; estimates exclude retries.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
